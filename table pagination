 const [page, setPage] = React.useState(1);
  const rowsPerPage = 4;

  const pages = Math.ceil((menus?.data?.$values.length ?? 0)/ rowsPerPage);

  const items = React.useMemo(() => {
    const start = (page - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    return menus?.data.$values.slice(start, end);
  }, [page, menus?.data.$values]);







