import React, { useEffect, useState } from 'react';
import { VictoryPie, VictoryAnimation, VictoryLabel } from 'victory';

// Definición de la interfaz para los datos
interface DataPoint {
  x: number;
  y: number;
}

// Función que genera los datos del gráfico basado en el porcentaje
function getData(percent: number): DataPoint[] {
  return [{ x: 1, y: percent }, { x: 2, y: 100 - percent }];
}

const App: React.FC = () => {
  const [percent, setPercent] = useState<number>(25);
  const [data, setData] = useState<DataPoint[]>(getData(25));

  useEffect(() => {
    const setStateInterval = window.setInterval(() => {
      let newPercent = 25 + Math.random() * 25;
      newPercent = newPercent > 100 ? 0 : newPercent;
      setPercent(newPercent);
      setData(getData(newPercent));
    }, 2000);

    return () => {
      window.clearInterval(setStateInterval);
    };
  }, []);

  return (
    <div>
      <svg viewBox="0 0 400 400" width="100%" height="100%">
        <VictoryPie
          standalone={false}
          animate={{ duration: 1000 }}
          width={400}
          height={400}
          data={data}
          innerRadius={120}
          cornerRadius={25}
          labels={() => null}
          style={{
            data: {
              fill: ({ datum }) => {
                const color = datum.y > 30 ? 'green' : 'red';
                return datum.x === 1 ? color : 'transparent';
              },
            },
          }}
        />
        <VictoryAnimation duration={1000} data={{ percent }}>
          {(newProps:any) => (
            <VictoryLabel
              textAnchor="middle"
              verticalAnchor="middle"
              x={200}
              y={200}
              // Convertir el porcentaje a string
              text={`${Math.round(newProps.percent)}%`}
              style={{ fontSize: 45 }}
            />
          )}
        </VictoryAnimation>
      </svg>
    </div>
  );
};

// Componente principal
const Home: React.FC = () => {
  return <App />;
};

export default Home;













